# Section B - merge and concat

students = {
    'Student_ID': [101,102,103,104],
    'Name': ['Amit', 'Sara', 'john', 'priya'],   
    }

marks ={
    'Student_ID': [101,102,103,104],
    'marks': [78,85,92,88]    
    }

students = pd.DataFrame(students)
marks = pd.DataFrame(marks)
# Tasks :

# perform inner merge 
df_inner = pd.merge(students, marks, on='Student_ID', how='inner')
print(df_inner)

# perform left merge
df_left = pd.merge(students, marks, on='Student_ID', how='left')
print(df_left)

# perform outer merge
df_outer = pd.merge(students, marks, on='Student_ID', how='outer')
print(df_outer)

# concatenate two dataframes along vertically
df_concat_rows = pd.concat([students, marks], axis=0)
print(df_concat_rows)

# concatenate two dataframes along horizantly
df_concat_cols = pd.concat([students, marks], axis=1)   
print(df_concat_cols)

# explain the difference between merge and concat 
# Merge is used to combine two dataframes based on a common column or index
# Merge is more suitable for combining data based on specific keys 


# concat is used to combine dataframes along a particular axis (either vertically(row) or horizontally(columns)) without considering any common columns. 
# concat is useful for stacking dataframes together.

